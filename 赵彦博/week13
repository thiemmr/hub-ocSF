# 5. 四层记忆系统
# ═══════════════════════════════════════════════════════════════

class Memory:
    """Layer 1 会话 / Layer 2 近期对话 / Layer 3 (SOUL+USER+AGENTS+MEMORY) / Layer 4 语义检索"""

    def __init__(self, base_dir: Optional[Path] = None):
        self.dir = base_dir or Path(__file__).parent / "memory"
        self.dir.mkdir(parents=True, exist_ok=True)
        defaults = {
            "SOUL.md": "# 系统人设 (SOUL)\n- 你是一个智能助手，具备渐进式技能加载能力。\n- 你可以根据用户需求动态加载和执行技能。\n- 回答简洁、准确、有帮助。\n",
            "USER.md": "# 用户画像 (USER)\n- 用户画像将在交互过程中逐步完善。\n",
            "AGENTS.md": "# 操作规范 (AGENTS)\n- 优先使用技能处理特定领域任务。\n- 保护用户隐私，不泄露敏感信息。\n",
            "MEMORY.md": "# 长期记忆 (MEMORY)\n- 记忆条目将在 Flush 过程中生成。\n",
        }
        for fn, c in defaults.items():
            fp = self.dir / fn
            if not fp.exists(): fp.write_text(c, encoding="utf-8")

    def load_layers(self, recent: Optional[List[Dict]] = None) -> List[MemoryLayer]:
        layers = []
        specs = [
            ("soul", "🧠", "Layer 3a  SOUL（人格定义）", "SOUL.md"),
            ("user_profile", "👤", "Layer 3b  USER（用户画像）", "USER.md"),
            ("agents_manual", "📋", "Layer 3c  AGENTS（操作规范）", "AGENTS.md"),
            ("long_term_memory", "💾", "Layer 3d  MEMORY（长期记忆）", "MEMORY.md"),
        ]
        for name, icon, label, fn in specs:
            c = self._read(fn)
            layers.append(MemoryLayer(name=name, icon=icon, label=label, content=c, char_count=len(c)))
        if recent:
            txt = "\n".join(f"{m['role']}: {m['content'][:200]}" for m in recent[-10:])
            layers.append(MemoryLayer(name="daily_log", icon="🫧", label="Layer 2   近期对话",
                                      content=txt, char_count=len(txt)))
        return layers

    def build_prompt(self, recent: Optional[List[Dict]] = None) -> str:
        parts = []
        for layer in self.load_layers(recent):
            if layer.content.strip():
                parts.append(f"## {layer.label}\n{layer.content.strip()}")
        return "\n\n".join(parts)

    def flush(self, msgs: List[Dict]) -> Dict:
        if not msgs: return {"error": "无消息"}
        entries = [f"- [{time.strftime('%Y-%m-%d')}] {m['content'][:120]}..."
                   for m in msgs[-20:] if m["role"] == "user" and len(m["content"]) > 30]
        if entries:
            fp = self.dir / "MEMORY.md"
            fp.write_text(fp.read_text(encoding="utf-8") + "\n" + "\n".join(entries), encoding="utf-8")
        return {"processed": len(msgs), "new_entries": len(entries)}

    def _read(self, fn: str) -> str:
        fp = self.dir / fn
        return fp.read_text(encoding="utf-8") if fp.exists() else ""

    def show(self):
        print(f"\n{C}=== USER.md ==={R}\n{self._read('USER.md')[:1500]}")
        print(f"\n{C}=== MEMORY.md ==={R}\n{self._read('MEMORY.md')[:2000]}\n")

