"""
渐进式技能加载与执行 Harness
Progressive Skill Loading & Execution Harness
=============================================
启动时仅扫描技能元数据（零导入），触发匹配时才渐进式动态加载。
支持: 技能链 / 热重载 / 执行统计 / 四层记忆 / 自动 Flush
"""

import importlib.util, json, logging, os, re, sys, time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Callable, Dict, List, Optional, Tuple

logging.basicConfig(level=logging.WARNING)
logger = logging.getLogger("harness")

# ── 终端颜色 ─────────────────────────────────────────────────
R = "\033[0m"; B = "\033[1m"; C = "\033[36m"; G = "\033[32m"
Y = "\033[33m"; M = "\033[35m"; E = "\033[31m"; D = "\033[2m"

# ═══════════════════════════════════════════════════════════════
# 1. 核心类型
# ═══════════════════════════════════════════════════════════════

@dataclass
class Manifest:
    """技能元数据 — 发现阶段即可获取，无需导入模块"""
    name: str = ""
    version: str = "1.0.0"
    description: str = ""
    author: str = ""
    triggers: List[str] = field(default_factory=list)
    keywords: List[str] = field(default_factory=list)
    dependencies: List[str] = field(default_factory=list)
    priority: int = 0
    category: str = "general"
    examples: List[str] = field(default_factory=list)

@dataclass
class SkillContext:
    session_id: str = ""; user_input: str = ""
    messages: List[Dict] = field(default_factory=list)
    memory_layers: Dict[str, Any] = field(default_factory=dict)
    workspace: str = ""

@dataclass
class SkillResult:
    """技能执行结果，next_skill 支持技能链"""
    success: bool = True; content: str = ""
    error: Optional[str] = None
    metadata: Dict[str, Any] = field(default_factory=dict)
    next_skill: Optional[str] = None

@dataclass
class MemoryLayer:
    name: str; icon: str; label: str; content: str = ""; char_count: int = 0

# ═══════════════════════════════════════════════════════════════
# 2. 技能注册表 — 仅扫描 manifest（零导入）
# ═══════════════════════════════════════════════════════════════

class Registry:
    """启动时扫描 skills/ 目录，读取所有 manifest，不做任何 import。
       支持两种定义方式: Python __manifest__ 或 skill.json"""

    def __init__(self, skills_dir: Optional[Path] = None):
        self.dir = skills_dir or Path(__file__).parent / "skills"
        self.dir.mkdir(parents=True, exist_ok=True)
        (self.dir / "__init__.py").touch()
        self.manifests: Dict[str, Manifest] = {}
        self._trigger_idx: Dict[str, List[str]] = {}
        self._discover()

    def _discover(self):
        self.manifests.clear(); self._trigger_idx.clear()
        for entry in sorted(self.dir.iterdir()):
            if not entry.is_dir() or entry.name.startswith("_"): continue
            mf = self._read_py_manifest(entry) or self._read_json_manifest(entry)
            if mf:
                self.manifests[mf.name] = mf
                for t in mf.triggers + mf.keywords:
                    self._trigger_idx.setdefault(t.lower(), []).append(mf.name)
        logger.info(f"注册完成: {len(self.manifests)} 个技能")

    def _read_py_manifest(self, d: Path) -> Optional[Manifest]:
        """从 __init__.py 或 skill.py 静态提取 __manifest__ 字典"""
        for fn in ["__init__.py", "skill.py"]:
            fp = d / fn
            if not fp.exists(): continue
            try:
                src = fp.read_text(encoding="utf-8")
                mx = re.search(r'__manifest__\s*=\s*(\{.*?\n\})', src, re.DOTALL)
                if not mx: return None
                raw = mx.group(1)
                raw = re.sub(r'\b(?:None|True|False)\b',
                             lambda t: {"None":"null","True":"true","False":"false"}[t.group()], raw)
                raw = re.sub(r',\s*}', '}', raw)
                data = json.loads(raw)
                data.setdefault("name", d.name)
                fields = Manifest.__dataclass_fields__
                return Manifest(**{k: v for k, v in data.items() if k in fields})
            except Exception as e:
                logger.warning(f"解析 {d.name} manifest: {e}")
        return None

    def _read_json_manifest(self, d: Path) -> Optional[Manifest]:
        fp = d / "skill.json"
        if not fp.exists(): return None
        try:
            data = json.loads(fp.read_text(encoding="utf-8"))
            data.setdefault("name", d.name)
            fields = Manifest.__dataclass_fields__
            return Manifest(**{k: v for k, v in data.items() if k in fields})
        except Exception: return None

    def match(self, user_input: str, top_k: int = 3) -> List[Tuple[Manifest, float]]:
        """三级匹配: 精确触发词 → 关键词部分匹配 → 描述语义相似"""
        inp = user_input.lower()
        scores: Dict[str, float] = {}
        # L1: 精确触发词
        for trigger, names in self._trigger_idx.items():
            if trigger in inp:
                for name in names:
                    m = self.manifests.get(name)
                    if not m: continue
                    bonus = 0.3 if trigger in [t.lower() for t in m.triggers] else 0.15
                    scores[name] = scores.get(name, 0) + 0.6 + len(trigger) * 0.02 + bonus
        # L2: 关键词部分匹配
        inp_words = set(re.findall(r'\w+', inp))
        for name, m in self.manifests.items():
            for kw in m.keywords:
                if kw.lower() in inp:
                    scores[name] = scores.get(name, 0) + 0.25
                if (inp_words & set(re.findall(r'\w+', kw.lower()))):
                    scores[name] = scores.get(name, 0) + 0.1
        # L3: 描述相似度
        for name, m in self.manifests.items():
            desc_words = set(re.findall(r'\w+', m.description.lower()))
            overlap = inp_words & desc_words
            if overlap:
                union = inp_words | desc_words
                scores[name] = scores.get(name, 0) + (len(overlap) / len(union) if union else 0) * 0.3
        # 优先级加权
        for name in scores:
            m = self.manifests.get(name)
            if m: scores[name] += m.priority * 0.05
        ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)[:top_k]
        return [(self.manifests[n], s) for n, s in ranked if n in self.manifests and s > 0.15]

    def list_all(self) -> List[Manifest]: return sorted(self.manifests.values(), key=lambda m: (m.category, m.name))
    def refresh(self): self._discover()

# ═══════════════════════════════════════════════════════════════
# 3. 渐进式加载器
# ═══════════════════════════════════════════════════════════════

class Loader:
    """仅在触发匹配时才进行模块导入，已加载的技能缓存复用"""

    def __init__(self, skills_dir: Path):
        self.dir = skills_dir
        self._cache: Dict[str, Any] = {}
        self._failures: Dict[str, str] = {}
        self._stats: Dict[str, Dict] = {}  # name → {load_time, call_count, last_used}

    def load(self, m: Manifest) -> Optional[Any]:
        if m.name in self._cache:
            s = self._stats[m.name]; s["call_count"] += 1; s["last_used"] = time.time()
            return self._cache[m.name]
        if m.name in self._failures:
            logger.warning(f"[跳过] {m.name}: 之前导入失败"); return None
        t0 = time.time()
        for fn in ["__init__.py", "skill.py"]:
            fp = self.dir / m.name / fn
            if not fp.exists(): continue
            try:
                sub = [str(self.dir / m.name)] if fn == "__init__.py" else None
                spec = importlib.util.spec_from_file_location(f"skills.{m.name}", fp, submodule_search_locations=sub)
                mod = importlib.util.module_from_spec(spec)
                sys.modules[f"skills.{m.name}"] = mod
                spec.loader.exec_module(mod)
                if hasattr(mod, "execute"):
                    elapsed = time.time() - t0
                    self._cache[m.name] = mod
                    self._stats[m.name] = {"load_time": elapsed, "call_count": 1, "last_used": time.time()}
                    logger.info(f"[加载] {m.name} ({elapsed:.3f}s)")
                    return mod
            except Exception as e:
                logger.error(f"[失败] {m.name}: {e}")
        self._failures[m.name] = "import failed"
        return None

    def is_loaded(self, n: str) -> bool: return n in self._cache
    def clear(self): self._cache.clear(); self._failures.clear(); self._stats.clear()
    def loaded_count(self) -> int: return len(self._cache)

# ═══════════════════════════════════════════════════════════════
# 4. 技能执行器
# ═══════════════════════════════════════════════════════════════

class Executor:
    """组装上下文 → 执行技能 → 记录指标，支持技能链"""

    def __init__(self, loader: Loader, memory_fn: Optional[Callable] = None):
        self.loader = loader
        self.memory_fn = memory_fn
        self.history: List[Dict] = []

    def execute(self, m: Manifest, user_input: str, messages: List[Dict],
                workspace: str = "") -> SkillResult:
        mod = self.loader.load(m)
        if not mod:
            return SkillResult(success=False, error=f"技能 '{m.name}' 加载失败")

        ctx = SkillContext(
            session_id=str(time.time_ns()), user_input=user_input,
            messages=messages, workspace=workspace or str(Path.cwd()),
        )
        if self.memory_fn:
            try: ctx.memory_layers = self.memory_fn()
            except Exception: pass

        t0 = time.time()
        try:
            result = mod.execute(ctx, user_input)
            if isinstance(result, str): result = SkillResult(success=True, content=result)
            elif isinstance(result, dict): result = SkillResult(**result)
            elif not isinstance(result, SkillResult): result = SkillResult(success=True, content=str(result))
        except Exception as ex:
            elapsed = time.time() - t0
            logging.error(f"技能 {m.name} 异常: {ex}", exc_info=True)
            result = SkillResult(success=False, error=f"{type(ex).__name__}: {ex}",
                                 metadata={"elapsed": elapsed})

        result.metadata["elapsed"] = time.time() - t0
        result.metadata["skill"] = m.name
        self.history.append({"skill": m.name, "success": result.success,
                             "elapsed": result.metadata["elapsed"],
                             "input": user_input[:60]})
        return result

    def stats(self) -> Dict:
        if not self.history: return {"total": 0}
        total = len(self.history)
        ok = sum(1 for e in self.history if e["success"])
        avg = sum(e["elapsed"] for e in self.history) / total
        return {"total": total, "success": ok, "failed": total - ok, "avg_time": f"{avg:.3f}s"}

