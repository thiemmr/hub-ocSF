# 7. 主 Harness
# ═══════════════════════════════════════════════════════════════

class Harness:
    MATCH_THRESHOLD = 0.18
    AUTO_FLUSH = 20

    def __init__(self, skills_dir: Optional[Path] = None):
        self.skills_dir = skills_dir or Path(__file__).parent / "skills"
        _create_builtins(self.skills_dir)
        self.registry = Registry(self.skills_dir)
        self.loader = Loader(self.skills_dir)
        self.memory = Memory()
        self.executor = Executor(self.loader,
                                 lambda: {ly.name: ly for ly in self.memory.load_layers(self.msgs)})
        self.msgs: List[Dict] = []
        self._client = None; self._model = None

    def _llm_init(self):
        if self._client: return
        import openai
        key = os.environ.get("DASHSCOPE_API_KEY") or os.environ.get("OPENAI_API_KEY")
        if not key: raise EnvironmentError("请设置 DASHSCOPE_API_KEY 或 OPENAI_API_KEY")
        base = os.environ.get("OPENAI_BASE_URL", "https://dashscope.aliyuncs.com/compatible-mode/v1")
        model = os.environ.get("LLM_MODEL", "qwen-plus")
        self._client = openai.OpenAI(api_key=key, base_url=base)
        self._model = model

    def _chat(self, sys_prompt: str, inp: str) -> str:
        self._llm_init()
        ms = [{"role":"system","content":sys_prompt}] + self.msgs[-16:] + [{"role":"user","content":inp}]
        print(f"{G}Muse：{R}", end="", flush=True)
        resp = ""
        for ch in self._client.chat.completions.create(
            model=self._model, messages=ms, temperature=0.7, stream=True):
            d = ch.choices[0].delta.content or ""
            print(d, end="", flush=True); resp += d
        print()
        return resp

    def _print_layers(self):
        print(f"\n{C}{'─'*60}{R}\n{C}  四层记忆加载情况{R}\n{C}{'─'*60}{R}")
        for ly in self.memory.load_layers(self.msgs):
            print(f"  {ly.icon} {ly.label}  {D}[{ly.char_count} 字符]{R}")
        print(f"{C}{'─'*60}{R}\n")

    def _print_skills(self):
        ms = self.registry.list_all()
        cats: Dict[str, List[Manifest]] = {}
        for m in ms: cats.setdefault(m.category, []).append(m)
        print(f"\n{C}{'─'*60}{R}\n{C}  技能列表 ({len(ms)} 个){R}\n{C}{'─'*60}{R}")
        for cat, skills in sorted(cats.items()):
            print(f"\n  {B}[{cat}]{R}")
            for s in skills:
                loaded = self.loader.is_loaded(s.name)
                st = f"{G}● 已加载{R}" if loaded else f"{D}○ 待加载{R}"
                stat = self.loader._stats.get(s.name, {})
                extra = f" x{stat['call_count']}" if stat.get("call_count", 0) > 0 else ""
                print(f"    {st} {B}{s.name}{R} v{s.version}{D}{extra}{R}\n      {D}{s.description}{R}\n      {D}触发: {', '.join(s.triggers[:5])}{R}")
        print(f"\n  已加载 {self.loader.loaded_count()}/{len(ms)}  匹配阈值: {self.MATCH_THRESHOLD}\n{C}{'─'*60}{R}\n")

    def _do_flush(self):
        ms = [m for m in self.msgs if m["role"] in ("user", "assistant")]
        if not ms: print(f"{Y}会话为空，跳过 Flush。{R}"); return
        print(f"\n{M}{'═'*60}{R}\n{M}  Memory Flush  —  {len(ms)} 条消息{R}")
        result = self.memory.flush(ms)
        if "error" in result: print(f"{Y}  {result['error']}{R}"); return
        print(f"  {G}新增记忆: {result['new_entries']} 条{R}\n{M}{'═'*60}{R}\n")

    def run(self):
        print(f"\n{B}{'═'*60}{R}\n{B}  渐进式技能加载与执行 Harness{R}\n{B}{'═'*60}{R}")
        print(f"  已发现 {C}{len(self.registry.manifests)}{R} 个技能  |  已加载 {C}{self.loader.loaded_count()}{R} 个（渐进式）")
        print(f"  {D}/skills /reload /flush /memory /layers /stats /new /exit{R}\n{B}{'═'*60}{R}")

        self._print_layers()

        while True:
            try: inp = input(f"{B}你：{R}").strip()
            except (KeyboardInterrupt, EOFError): inp = "/exit"
            if not inp: continue

            # ── 命令处理 ──────────────────────────────────────
            if inp == "/exit":
                self._do_flush()
                s = self.executor.stats()
                print(f"再见! 加载 {self.loader.loaded_count()} 技能  执行 {s.get('total',0)} 次"); break
            if inp == "/skills": self._print_skills(); continue
            if inp == "/reload":
                self.loader.clear(); self.registry.refresh()
                print(f"{G}热重载完成! 发现 {len(self.registry.list_all())} 个技能{R}"); continue
            if inp == "/flush": self._do_flush(); continue
            if inp == "/memory": self.memory.show(); continue
            if inp == "/layers": self._print_layers(); continue
            if inp == "/stats":
                s = self.executor.stats()
                print(f"\n{C}执行统计{R}: 总 {s.get('total',0)}  成功 {s.get('success',0)}  失败 {s.get('failed',0)}  均时 {s.get('avg_time','-')}\n"); continue
            if inp == "/new": self.msgs = []; print(f"{G}新会话已开始。{R}"); self._print_layers(); continue

            # ── 核心路由: 匹配 → 渐进加载 → 执行 ─────────────
            matches = self.registry.match(inp)
            if matches and matches[0][1] > self.MATCH_THRESHOLD:
                m, score = matches[0]
                print(f"  {D}[技能匹配: {m.name} ({int(score*100)}%)]{R}")

                # 渐进式加载并执行技能
                result = self.executor.execute(m, inp, self.msgs)
                if not result.success:
                    print(f"{E}[技能失败] {result.error[:200]}{R}")
                sys_p = self.memory.build_prompt(self.msgs) + f"\n## 激活技能: {m.name}\n技能输出: {result.content[:500]}"
                print(f"{G}Muse [{m.name}]：{R}", end="", flush=True)
            else:
                sys_p = self.memory.build_prompt(self.msgs)

            try:
                resp = self._chat(sys_p, inp)
            except Exception as e:
                print(f"{E}[LLM 错误] {e}{R}")
                resp = f"[离线] 收到: {inp[:100]}"

            self.msgs.append({"role":"user","content":inp})
            self.msgs.append({"role":"assistant","content":resp})

            # 自动 Flush
            if sum(1 for x in self.msgs if x["role"]=="user") >= self.AUTO_FLUSH:
                print(f"\n{Y}[自动 Flush: 消息数达 {self.AUTO_FLUSH}]{R}"); self._do_flush()

def main(): Harness().run()
if __name__ == "__main__": main()
